# SpaceATC Environment Variables — PRD Section 14

CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
SPACE_TRACK_USERNAME=           # Optional backup (register at space-track.org)
SPACE_TRACK_PASSWORD=           # Optional backup

GROQ_API_KEY=                   # All LLM calls use Groq (groq)
GROQ_MODEL=                     # Optional override, default openai/gpt-oss-120b (e.g. openai/gpt-oss-20b for lower latency)

SQLITE_PATH=./spaceatc.db
WEBSOCKET_PING_INTERVAL=5       # seconds
TLE_REFRESH_INTERVAL=3600       # seconds (refresh every hour)

SCREENING_DISTANCE_KM=5.0
PC_ALERT_THRESHOLD=0.0001
PC_SAFE_THRESHOLD=0.000001

# Seconds an operator has to review a proposed maneuver in the HITL panel
# before it is auto-vetoed. Defaults to 30. Raise it for a live walkthrough so
# the review window cannot expire mid-narration; the value set here is the
# value displayed on screen.
VITE_HITL_TIMEOUT_S=60
